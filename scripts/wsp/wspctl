#!/usr/bin/env bash
# Entry point Codex calls (see scripts/wsp/codex/WSP_TASK.md). Uses the Python that has torch:
# $WSP_PY if set, else the project's conda env, else python3.
here="$(cd "$(dirname "$0")" && pwd)"
py=${WSP_PY:-}
if [[ -z $py ]]; then
  for c in "$HOME/miniconda3/envs/ldp-attacker-detector/bin/python" "$HOME/miniconda3/envs/attacker-detector/bin/python" \
           "$HOME/anaconda3/envs/ldp-attacker-detector/bin/python" "$HOME/miniforge3/envs/ldp-attacker-detector/bin/python"; do
    [[ -x $c ]] && { py=$c; break; }
  done
fi
py=${py:-python3}
export MPLCONFIGDIR="${MPLCONFIGDIR:-$here/../../results/wsp_codex/.mpl}" PYTHONDONTWRITEBYTECODE=1
exec "$py" "$here/wspctl.py" "$@"
